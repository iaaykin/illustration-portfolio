<title>Ayca Akin | Illustrator & Writer</title>

<style>

:root{
    --bg:#111;
    --card:#1a1a1a;
    --text:#f5f5f5;
    --secondary:#b5b5b5;
    --accent:#d8b48d;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: Georgia, serif;
    background:var(--bg);
    color:var(--text);
}

header{
    text-align:center;
    padding:80px 20px 50px;
}

header h1{
    font-size:3rem;
    margin-bottom:10px;
}

header p{
    color:var(--secondary);
    max-width:600px;
    margin:auto;
    line-height:1.6;
}

.links{
    margin-top:25px;
}

.links a{
    color:var(--accent);
    text-decoration:none;
    margin:0 12px;
}

.gallery{
    width:90%;
    max-width:1300px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:15px;
    padding-bottom:80px;
}

.artwork{
    overflow:hidden;
    border-radius:10px;
    cursor:pointer;
    background:var(--card);
}

.artwork img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:.4s;
}

.artwork:hover img{
    transform:scale(1.05);
}

.about{
    max-width:800px;
    margin:0 auto 80px;
    padding:0 25px;
}

.about h2{
    margin-bottom:20px;
}

.about p{
    line-height:1.8;
    color:var(--secondary);
}

.lightbox{
    display:none;
    position:fixed;
    background:rgba(0,0,0,.9);
    top:0;
    left:0;
    width:100%;
    height:100%;
    justify-content:center;
    align-items:center;
    z-index:999;
}

.lightbox img{
    max-width:90%;
    max-height:90%;
}

.close{
    position:absolute;
    top:20px;
    right:30px;
    font-size:2rem;
    color:white;
    cursor:pointer;
}

footer{
    text-align:center;
    padding:40px;
    color:var(--secondary);
}

</style>
</head>

